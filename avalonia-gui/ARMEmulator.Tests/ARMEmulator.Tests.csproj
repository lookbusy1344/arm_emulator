<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Testing Framework -->
    <PackageReference Include="xunit.v3" Version="4.*" />

    <!-- Mocking & Assertions -->
    <PackageReference Include="NSubstitute" Version="6.*" />
    <PackageReference Include="AwesomeAssertions" Version="9.*" />

    <!-- Avalonia Headless Testing -->
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Architecture guards (CodeStyle_*) inspect C# and Razor through the compilers belonging to the SDK
         selected for this build. Referencing the SDK copies keeps parsing aligned with the build. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="$(MSBuildSDKsPath)/Microsoft.NET.Sdk.Razor/source-generators/Microsoft.CodeAnalysis.Razor.Compiler.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ARMEmulator\ARMEmulator.csproj" />
  </ItemGroup>

</Project>