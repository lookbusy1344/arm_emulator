<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Splitters: a 1 px divider inside a wider drag area -->
    <Style Selector="GridSplitter.column">
        <Setter Property="Width" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Rectangle Width="1" HorizontalAlignment="Center" Fill="{DynamicResource DividerBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.row">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Rectangle Height="1" VerticalAlignment="Center" Fill="{DynamicResource DividerBrush}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Text roles -->
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>
    <Style Selector="TextBlock.data">
        <Setter Property="FontFamily" Value="{DynamicResource DataFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DataFontSize}" />
    </Style>
    <Style Selector="TextBlock.header">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    </Style>
    <Style Selector="TextBox.data">
        <Setter Property="FontFamily" Value="{DynamicResource DataFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DataFontSize}" />
    </Style>

    <!-- Toolbar button: icon beside a label -->
    <Style Selector="Button.tool">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tool PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="Rectangle.toolSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Fill" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- Status pill: colour by state, selected through the Tag the view model supplies -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Background" Value="{DynamicResource StateDisconnectedBrush}" />
    </Style>
    <Style Selector="Border.pill > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnStateBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.pill[Tag=Idle]">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector="Border.pill[Tag=Running]">
        <Setter Property="Background" Value="{DynamicResource StateRunningBrush}" />
    </Style>
    <Style Selector="Border.pill[Tag=Breakpoint]">
        <Setter Property="Background" Value="{DynamicResource StateBreakpointBrush}" />
    </Style>
    <Style Selector="Border.pill[Tag=Halted]">
        <Setter Property="Background" Value="{DynamicResource StateHaltedBrush}" />
    </Style>
    <Style Selector="Border.pill[Tag=Error]">
        <Setter Property="Background" Value="{DynamicResource StateErrorBrush}" />
    </Style>
    <Style Selector="Border.pill[Tag=WaitingForInput]">
        <Setter Property="Background" Value="{DynamicResource StateWaitingBrush}" />
    </Style>

    <!-- Panel header: a compact strip above a table -->
    <Style Selector="Border.panelHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Table: column headers and data rows -->
    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Border.tableHeader TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.dataRow">
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.4" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.dataRow.highlight">
        <Setter Property="Background" Value="{DynamicResource MemoryWriteBrush}" />
    </Style>
    <Style Selector="Border.dataRow.current">
        <Setter Property="Background" Value="{DynamicResource PcLineBrush}" />
    </Style>
    <Style Selector="ItemsControl.striped StackPanel > ContentPresenter:nth-child(2n)">
        <Setter Property="Background" Value="{DynamicResource RowAlternateBrush}" />
    </Style>
    <Style Selector="PathIcon.marker">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="PathIcon.breakpointMarker">
        <Setter Property="Foreground" Value="{DynamicResource BreakpointBrush}" />
    </Style>
    <Style Selector="PathIcon.pcMarker">
        <Setter Property="Foreground" Value="{DynamicResource PcMarkerBrush}" />
    </Style>

    <!-- Inline error inside a panel -->
    <Style Selector="Border.inlineError">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.inlineError > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" />
    </Style>

    <!-- Console: terminal surface, borderless input -->
    <Style Selector="TextBox.terminal">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DataFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DataFontSize}" />
    </Style>
    <Style Selector="TextBox.terminal">
        <Setter Property="PlaceholderForeground" Value="{DynamicResource ConsoleTextDimBrush}" />
    </Style>
    <Style Selector="Border.inputRow Button.tool">
        <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
    </Style>
    <Style Selector="Border.inputRow Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ConsoleTextDimBrush}" />
    </Style>
    <Style Selector="TextBox.terminal:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBox.terminal:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.inputRow">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Border.inputRow.waiting">
        <Setter Property="Background" Value="{DynamicResource ConsoleInputWaitingBrush}" />
    </Style>
    <Style Selector="TextBlock.prompt">
        <Setter Property="Foreground" Value="{DynamicResource ConsoleTextBrush}" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="FontFamily" Value="{DynamicResource DataFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource DataFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.inputRow.waiting TextBlock.prompt">
        <Setter Property="Foreground" Value="{DynamicResource StateWaitingBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
</Styles>
