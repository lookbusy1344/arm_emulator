<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design tokens. Views reference these keys; literal colours and sizes live only in this file. -->

    <!-- Spacing scale -->
    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>

    <!-- UI type scale -->
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBody">12</x:Double>
    <x:Double x:Key="FontSizeEmphasis">12</x:Double>
    <x:Double x:Key="FontSizeTitle">12</x:Double>

    <!-- Data type: registers, memory, disassembly, console. The editor takes its size from settings. -->
    <FontFamily x:Key="DataFontFamily">avares://ARMEmulator/Assets/Fonts#JetBrains Mono</FontFamily>
    <x:Double x:Key="DataFontSize">11</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="DividerBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#0A64D8" />
            <SolidColorBrush x:Key="RowAlternateBrush" Color="#0A000000" />

            <SolidColorBrush x:Key="ChangedRegisterBrush" Color="#6634C759" />
            <SolidColorBrush x:Key="MemoryWriteBrush" Color="#80FFE066" />
            <SolidColorBrush x:Key="BreakpointBrush" Color="#D93025" />
            <SolidColorBrush x:Key="PcMarkerBrush" Color="#1A73E8" />
            <SolidColorBrush x:Key="PcLineBrush" Color="#261A73E8" />
            <SolidColorBrush x:Key="CurrentLineBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="FlagOnBrush" Color="#248A3D" />

            <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#008000" />
            <SolidColorBrush x:Key="SyntaxInstructionBrush" Color="#0000FF" />
            <SolidColorBrush x:Key="SyntaxRegisterBrush" Color="#001080" />
            <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#098658" />
            <SolidColorBrush x:Key="SyntaxStringBrush" Color="#A31515" />
            <SolidColorBrush x:Key="SyntaxLabelBrush" Color="#795E26" />
            <SolidColorBrush x:Key="SyntaxDirectiveBrush" Color="#AF00DB" />

            <SolidColorBrush x:Key="GutterBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="ConsoleTextDimBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ConsoleInputWaitingBrush" Color="#33FF9F0A" />

            <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDECEA" />
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="#D93025" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#B3261E" />

            <SolidColorBrush x:Key="StateIdleBrush" Color="#34C759" />
            <SolidColorBrush x:Key="StateRunningBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="StateBreakpointBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="StateHaltedBrush" Color="#AF52DE" />
            <SolidColorBrush x:Key="StateErrorBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="StateWaitingBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="StateDisconnectedBrush" Color="#8E8E93" />
            <SolidColorBrush x:Key="OnStateBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#252526" />
            <SolidColorBrush x:Key="DividerBrush" Color="#3C3C3C" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AccentBrush" Color="#4DA3FF" />
            <SolidColorBrush x:Key="RowAlternateBrush" Color="#0DFFFFFF" />

            <SolidColorBrush x:Key="ChangedRegisterBrush" Color="#6630D158" />
            <SolidColorBrush x:Key="MemoryWriteBrush" Color="#66B38F00" />
            <SolidColorBrush x:Key="BreakpointBrush" Color="#FF5A4F" />
            <SolidColorBrush x:Key="PcMarkerBrush" Color="#5AA0FF" />
            <SolidColorBrush x:Key="PcLineBrush" Color="#335AA0FF" />
            <SolidColorBrush x:Key="CurrentLineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FlagOnBrush" Color="#30D158" />

            <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
            <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="SyntaxCommentBrush" Color="#6A9955" />
            <SolidColorBrush x:Key="SyntaxInstructionBrush" Color="#569CD6" />
            <SolidColorBrush x:Key="SyntaxRegisterBrush" Color="#9CDCFE" />
            <SolidColorBrush x:Key="SyntaxNumberBrush" Color="#B5CEA8" />
            <SolidColorBrush x:Key="SyntaxStringBrush" Color="#CE9178" />
            <SolidColorBrush x:Key="SyntaxLabelBrush" Color="#DCDCAA" />
            <SolidColorBrush x:Key="SyntaxDirectiveBrush" Color="#C586C0" />

            <SolidColorBrush x:Key="GutterBackgroundBrush" Color="#252526" />
            <SolidColorBrush x:Key="ConsoleBackgroundBrush" Color="#121212" />
            <SolidColorBrush x:Key="ConsoleTextBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="ConsoleTextDimBrush" Color="#8A8A8A" />
            <SolidColorBrush x:Key="ConsoleInputWaitingBrush" Color="#33FF9F0A" />

            <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#3B1F1E" />
            <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FF5A4F" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF8A80" />

            <SolidColorBrush x:Key="StateIdleBrush" Color="#30D158" />
            <SolidColorBrush x:Key="StateRunningBrush" Color="#0A84FF" />
            <SolidColorBrush x:Key="StateBreakpointBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="StateHaltedBrush" Color="#BF5AF2" />
            <SolidColorBrush x:Key="StateErrorBrush" Color="#FF453A" />
            <SolidColorBrush x:Key="StateWaitingBrush" Color="#FF9F0A" />
            <SolidColorBrush x:Key="StateDisconnectedBrush" Color="#8E8E93" />
            <SolidColorBrush x:Key="OnStateBrush" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
