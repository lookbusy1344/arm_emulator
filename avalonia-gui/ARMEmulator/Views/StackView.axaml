<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:Class="ARMEmulator.Views.StackView"
             x:DataType="vm:StackViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="panelHeader">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Classes="tool"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh the stack"
                        AutomationProperties.Name="Refresh stack">
                    <PathIcon Data="{StaticResource IconReset}" />
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="secondary" Text="SP" />
                        <TextBlock Classes="data" Text="{Binding StackPointer, StringFormat=0x{0:X8}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="secondary" Text="Size" />
                        <TextBlock Classes="data" Text="{Binding StackSize, StringFormat={}{0} bytes}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Classes="inlineError"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <Border DockPanel.Dock="Top" Name="StackHeader" Classes="tableHeader">
            <Grid ColumnDefinitions="64,80,90,40,*">
                <TextBlock Grid.Column="0" Text="Offset" />
                <TextBlock Grid.Column="1" Text="Address" />
                <TextBlock Grid.Column="2" Text="Value" />
                <TextBlock Grid.Column="3" Text="ASCII" />
                <TextBlock Grid.Column="4" Text="Note" />
            </Grid>
        </Border>

        <ScrollViewer>
            <ItemsControl Name="StackRows" Classes="striped" ItemsSource="{Binding StackEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="dataRow" Classes.current="{Binding IsCurrentSP}">
                            <Grid ColumnDefinitions="64,80,90,40,*">
                                <TextBlock Grid.Column="0" Classes="data secondary" Text="{Binding Offset}" />
                                <TextBlock Grid.Column="1" Classes="data secondary" Text="{Binding Address}" />
                                <TextBlock Grid.Column="2" Classes="data" Text="{Binding Value}" />
                                <TextBlock Grid.Column="3" Classes="data secondary" Text="{Binding Ascii}" />
                                <TextBlock Grid.Column="4" Classes="secondary" Text="{Binding Annotation}" FontStyle="Italic" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
