<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ARMEmulator.Views.UnsavedChangesWindow"
        Title="Unsaved changes"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Classes="dialogFooter">
            <StackPanel Name="ButtonRow" Classes="buttonRow">
                <Button Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsCancel="True" />
                <Button Name="DiscardButton" Content="Discard" Click="Discard_Click" />
                <Button Name="SaveButton" Content="Save" Click="Save_Click" IsDefault="True" Classes="accent" />
            </StackPanel>
        </Border>
        <TextBlock Name="MessageText" Margin="24" TextWrapping="Wrap" />
    </DockPanel>
</Window>
