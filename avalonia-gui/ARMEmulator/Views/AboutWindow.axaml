<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ARMEmulator.ViewModels"
        x:Class="ARMEmulator.Views.AboutWindow"
        x:DataType="vm:AboutWindowViewModel"
        Title="About ARM Emulator"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<StackPanel Name="ButtonRow" Classes="buttonRow">
				<Button Name="CloseButton" Content="Close" Click="CloseButton_Click" IsDefault="True" IsCancel="True" />
			</StackPanel>
		</Border>

		<StackPanel Margin="24" Spacing="4">
			<TextBlock Text="ARM Emulator" Classes="dialogTitle" Margin="0,0,0,8" />
			<TextBlock Text="An ARM assembly emulator with an HTTP backend and Swift and Avalonia frontends." Classes="hint" Margin="0,0,0,12" />

			<TextBlock Classes="sectionTitle" Text="FRONTEND (AVALONIA)" />
			<Grid ColumnDefinitions="90,*">
				<TextBlock Text="Version" />
				<TextBlock Grid.Column="1" Text="{Binding AppVersion}" Classes="value" />
			</Grid>

			<TextBlock Classes="sectionTitle" Text="BACKEND (GO)" Margin="0,12,0,0" />
			<Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto">
				<TextBlock Text="Version" />
				<TextBlock Grid.Column="1" Text="{Binding BackendVersion}"
				           Classes.value="{Binding IsBackendAvailable}"
				           Classes.unavailable="{Binding !IsBackendAvailable}" />
				<TextBlock Grid.Row="1" Text="Commit" IsVisible="{Binding IsBackendAvailable}" />
				<TextBlock Grid.Row="1" Grid.Column="1" Classes="data" Text="{Binding BackendCommit}" IsVisible="{Binding IsBackendAvailable}" />
				<TextBlock Grid.Row="2" Text="Built" IsVisible="{Binding IsBackendAvailable}" />
				<TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BackendBuildDate}" IsVisible="{Binding IsBackendAvailable}" />
			</Grid>
		</StackPanel>
	</DockPanel>
</Window>
