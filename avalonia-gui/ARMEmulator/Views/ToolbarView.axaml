<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:Class="ARMEmulator.Views.ToolbarView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <!-- Status pill -->
            <Border Classes="pill"
                    Tag="{Binding StatusKey}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTip.Tip="{Binding StatusText}"
                    AutomationProperties.Name="VM Status Indicator"
                    AutomationProperties.HelpText="{Binding StatusText}">
                <TextBlock Name="StatusLabel" Text="{Binding StatusLabel}" />
            </Border>

            <Button Name="RunButton"
                    Classes="tool"
                    Command="{Binding RunCommand}"
                    AutomationProperties.Name="Run Program">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconPlay}" />
                    <TextBlock Text="Run" />
                </StackPanel>
            </Button>
            <Button Name="PauseButton"
                    Classes="tool"
                    Command="{Binding PauseCommand}"
                    AutomationProperties.Name="Pause Execution">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconPause}" />
                    <TextBlock Text="Pause" />
                </StackPanel>
            </Button>

            <Rectangle Classes="toolSeparator" />

            <Button Name="StepButton"
                    Classes="tool"
                    Command="{Binding StepCommand}"
                    AutomationProperties.Name="Step Single Instruction">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStep}" />
                    <TextBlock Text="Step" />
                </StackPanel>
            </Button>
            <Button Name="StepOverButton"
                    Classes="tool"
                    Command="{Binding StepOverCommand}"
                    AutomationProperties.Name="Step Over Function">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStepOver}" />
                    <TextBlock Text="Step Over" />
                </StackPanel>
            </Button>
            <Button Name="StepOutButton"
                    Classes="tool"
                    Command="{Binding StepOutCommand}"
                    AutomationProperties.Name="Step Out of Function">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStepOut}" />
                    <TextBlock Text="Step Out" />
                </StackPanel>
            </Button>

            <Rectangle Classes="toolSeparator" />

            <Button Name="ResetButton"
                    Classes="tool"
                    Command="{Binding ResetCommand}"
                    AutomationProperties.Name="Reset Virtual Machine">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconReset}" />
                    <TextBlock Text="Reset" />
                </StackPanel>
            </Button>
            <Button Name="ShowPcButton"
                    Classes="tool"
                    Command="{Binding ShowPcCommand}"
                    AutomationProperties.Name="Show Program Counter in Editor">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconShowPc}" />
                    <TextBlock Text="Show PC" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
