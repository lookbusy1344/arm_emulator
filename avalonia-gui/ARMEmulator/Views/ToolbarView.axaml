<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:Class="ARMEmulator.Views.ToolbarView"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">
        <StackPanel Orientation="Horizontal" Spacing="2">
            <!-- Status pill -->
            <Border Classes="pill"
                    Tag="{Binding StatusKey}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    ToolTip.Tip="{Binding StatusText}"
                    AutomationProperties.Name="VM Status Indicator"
                    AutomationProperties.HelpText="{Binding StatusText}">
                <TextBlock Name="StatusLabel" Text="{Binding StatusLabel}" />
            </Border>

            <Button Classes="tool"
                    Command="{Binding LoadProgramCommand}"
                    ToolTip.Tip="Load Program (Ctrl+L)"
                    AutomationProperties.Name="Load Program"
                    AutomationProperties.AcceleratorKey="Ctrl+L">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconOpen}" />
                    <TextBlock Text="Load" />
                </StackPanel>
            </Button>

            <Rectangle Classes="toolSeparator" />

            <Button Classes="tool"
                    Command="{Binding RunCommand}"
                    ToolTip.Tip="Run (F5, Ctrl+R)"
                    AutomationProperties.Name="Run Program"
                    AutomationProperties.AcceleratorKey="F5">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconPlay}" />
                    <TextBlock Text="Run" />
                </StackPanel>
            </Button>
            <Button Classes="tool"
                    Command="{Binding PauseCommand}"
                    ToolTip.Tip="Pause (Ctrl+.)"
                    AutomationProperties.Name="Pause Execution"
                    AutomationProperties.AcceleratorKey="Ctrl+Period">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconPause}" />
                    <TextBlock Text="Pause" />
                </StackPanel>
            </Button>

            <Rectangle Classes="toolSeparator" />

            <Button Classes="tool"
                    Command="{Binding StepCommand}"
                    ToolTip.Tip="Step (F11, Ctrl+T)"
                    AutomationProperties.Name="Step Single Instruction"
                    AutomationProperties.AcceleratorKey="F11">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStep}" />
                    <TextBlock Text="Step" />
                </StackPanel>
            </Button>
            <Button Classes="tool"
                    Command="{Binding StepOverCommand}"
                    ToolTip.Tip="Step Over (F10, Ctrl+Shift+T)"
                    AutomationProperties.Name="Step Over Function"
                    AutomationProperties.AcceleratorKey="F10">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStepOver}" />
                    <TextBlock Text="Step Over" />
                </StackPanel>
            </Button>
            <Button Classes="tool"
                    Command="{Binding StepOutCommand}"
                    ToolTip.Tip="Step Out (Ctrl+Alt+T)"
                    AutomationProperties.Name="Step Out of Function"
                    AutomationProperties.AcceleratorKey="Ctrl+Alt+T">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconStepOut}" />
                    <TextBlock Text="Step Out" />
                </StackPanel>
            </Button>

            <Rectangle Classes="toolSeparator" />

            <Button Classes="tool"
                    Command="{Binding ResetCommand}"
                    ToolTip.Tip="Reset (Ctrl+Shift+R)"
                    AutomationProperties.Name="Reset Virtual Machine"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+R">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconReset}" />
                    <TextBlock Text="Reset" />
                </StackPanel>
            </Button>
            <Button Classes="tool"
                    Command="{Binding ShowPcCommand}"
                    ToolTip.Tip="Show PC (Ctrl+J)"
                    AutomationProperties.Name="Show Program Counter in Editor"
                    AutomationProperties.AcceleratorKey="Ctrl+J">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconShowPc}" />
                    <TextBlock Text="Show PC" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
