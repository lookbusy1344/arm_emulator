<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ARMEmulator.ViewModels"
        x:Class="ARMEmulator.Views.PreferencesWindow"
        x:DataType="vm:PreferencesWindowViewModel"
        Title="Preferences"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

	<DockPanel>
		<Border DockPanel.Dock="Bottom" Classes="dialogFooter">
			<StackPanel Name="ButtonRow" Classes="buttonRow">
				<Button Name="CancelButton" Content="Cancel" Click="CancelButton_Click" IsCancel="True" />
				<Button Name="OkButton" Content="OK" Click="OkButton_Click" IsDefault="True" Classes="accent" />
			</StackPanel>
		</Border>

		<TabControl Margin="16,8,16,16">
			<TabItem Header="General">
				<Grid Margin="0,16,0,0" ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
					<TextBlock Grid.Row="0" Text="Backend URL" VerticalAlignment="Center" />
					<TextBox Grid.Row="0" Grid.Column="2" Text="{Binding BackendUrl}" PlaceholderText="http://localhost:8080" />
					<TextBlock Grid.Row="1" Grid.Column="2" Classes="hint" Margin="0,0,0,12"
					           Text="The HTTP endpoint of the emulator backend. A change takes effect when the backend restarts." />

					<TextBlock Grid.Row="2" Text="Theme" VerticalAlignment="Center" />
					<ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" MinWidth="150" />
					<TextBlock Name="ThemeHint" Grid.Row="3" Grid.Column="2" Classes="hint" Margin="0,0,0,12" Text="Auto follows the system theme." />

					<TextBlock Grid.Row="4" Text="Recent files" VerticalAlignment="Center" />
					<NumericUpDown Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" MinWidth="120"
					               Value="{Binding RecentFilesLimit}" Minimum="1" Maximum="50" Increment="5" />

					<CheckBox Grid.Row="6" Grid.Column="2" Margin="0,8,0,0"
					          Content="Follow memory writes in the memory view"
					          IsChecked="{Binding AutoScrollToMemoryWrites}" />
				</Grid>
			</TabItem>

			<TabItem Header="Editor">
				<Grid Margin="0,16,0,0" ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
					<TextBlock Grid.Row="0" Text="Font size" VerticalAlignment="Center" />
					<StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
						<NumericUpDown Value="{Binding EditorFontSize}" Minimum="10" Maximum="24" Increment="1" MinWidth="120" />
						<TextBlock Text="pt" Classes="hint" VerticalAlignment="Center" />
					</StackPanel>

					<Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="12"
					        Background="{DynamicResource EditorBackgroundBrush}"
					        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4">
						<TextBlock Name="FontPreview"
						           FontFamily="{DynamicResource DataFontFamily}"
						           FontSize="{Binding EditorFontSize}"
						           Foreground="{DynamicResource EditorForegroundBrush}">
							<Run Text="MOV R0, #42" />
							<LineBreak />
							<Run Text="ADD R1, R0, #8" />
							<LineBreak />
							<Run Text="STR R1, [R2]" />
						</TextBlock>
					</Border>
					<TextBlock Grid.Row="2" Grid.ColumnSpan="3" Classes="hint" Text="The editor follows the font size at once." />
				</Grid>
			</TabItem>
		</TabControl>
	</DockPanel>
</Window>
