<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:Class="ARMEmulator.Views.MemoryView"
             x:DataType="vm:MemoryViewModel">
    <DockPanel>
        <!-- Address entry and quick jumps -->
        <Border DockPanel.Dock="Top" Classes="panelHeader">
            <StackPanel Spacing="4">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Classes="secondary" Text="Address" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Classes="data"
                             Text="{Binding AddressInput}"
                             PlaceholderText="0x8000 or 32768"
                             Width="120"
                             Margin="0,0,4,0"
                             AutomationProperties.Name="Memory address"
                             ToolTip.Tip="Memory address in hex (0x...) or decimal; press Enter or Go">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding NavigateToAddressCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Classes="tool" Padding="6,2" Content="Go" Command="{Binding NavigateToAddressCommand}"
                            ToolTip.Tip="Navigate to the address" />
                    <Rectangle Classes="toolSeparator" />
                    <Button Classes="tool" Padding="6,2" Content="PC" Command="{Binding JumpToPCCommand}" ToolTip.Tip="Jump to the program counter" />
                    <Button Classes="tool" Padding="6,2" Content="SP" Command="{Binding JumpToSPCommand}" ToolTip.Tip="Jump to the stack pointer" />
                    <Button Classes="tool" Padding="6,2" Content="R0" Command="{Binding JumpToRegisterCommand}" CommandParameter="0" ToolTip.Tip="Jump to the value of R0" />
                    <Button Classes="tool" Padding="6,2" Content="R1" Command="{Binding JumpToRegisterCommand}" CommandParameter="1" ToolTip.Tip="Jump to the value of R1" />
                    <Button Classes="tool" Padding="6,2" Content="R2" Command="{Binding JumpToRegisterCommand}" CommandParameter="2" ToolTip.Tip="Jump to the value of R2" />
                    <Button Classes="tool" Padding="6,2" Content="R3" Command="{Binding JumpToRegisterCommand}" CommandParameter="3" ToolTip.Tip="Jump to the value of R3" />
                </WrapPanel>
                <CheckBox IsChecked="{Binding AutoScrollToWrites}"
                          Content="Follow memory writes"
                          ToolTip.Tip="Scroll to an address when the program writes to it" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                Classes="inlineError"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <StackPanel Grid.IsSharedSizeScope="True">
                <Border Name="MemoryHeader" Classes="tableHeader">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MemoryBytes" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Address" />
                        <TextBlock Grid.Column="1" Text="Bytes" />
                        <TextBlock Grid.Column="2" Text="ASCII" Margin="16,0,0,0" />
                    </Grid>
                </Border>
                <ItemsControl Name="MemoryRows" Classes="striped" ItemsSource="{Binding FormattedRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="dataRow" Classes.highlight="{Binding IsHighlighted}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="MemoryBytes" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Classes="data secondary" Text="{Binding Address}" />
                                    <TextBlock Grid.Column="1" Classes="data" Text="{Binding HexBytes}" />
                                    <TextBlock Grid.Column="2" Classes="data secondary" Text="{Binding AsciiText}" Margin="16,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
