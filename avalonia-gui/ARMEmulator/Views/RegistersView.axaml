<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             xmlns:models="using:ARMEmulator.Models"
             x:Class="ARMEmulator.Views.RegistersView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <Style Selector="Border.registerRow">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.4" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.registerRow.changed">
            <Setter Property="Background" Value="{DynamicResource ChangedRegisterBrush}" />
        </Style>
        <Style Selector="Border.flag">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.flag.on">
            <Setter Property="Background" Value="{DynamicResource FlagOnBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FlagOnBrush}" />
        </Style>
        <Style Selector="Border.flag.on > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnStateBrush}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Status strip: VM state and condition flags -->
        <Border DockPanel.Dock="Bottom"
                Classes="registerRow"
                Classes.changed="{Binding AreFlagsChanged}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="secondary" Text="State" VerticalAlignment="Center" />
                <TextBlock Classes="data" Text="{Binding StatusLabel}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Classes="secondary" Text="Flags" VerticalAlignment="Center" />
                <ItemsControl Name="FlagPills" ItemsSource="{Binding RegisterFlags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FlagItem">
                            <Border Classes="flag"
                                    Classes.on="{Binding IsSet}"
                                    ToolTip.Tip="{Binding Name}">
                                <TextBlock Classes="data" Text="{Binding Letter}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Register table -->
        <ScrollViewer>
            <ItemsControl Name="RegisterRows" ItemsSource="{Binding RegisterRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:RegisterRow">
                        <Border Classes="registerRow" Classes.changed="{Binding IsChanged}">
                            <Grid ColumnDefinitions="48,Auto,*">
                                <TextBlock Classes="data secondary" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Classes="data hex" Text="{Binding Hex}" />
                                <TextBlock Grid.Column="2" Classes="data secondary base10" Text="{Binding Base10}"
                                           TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
