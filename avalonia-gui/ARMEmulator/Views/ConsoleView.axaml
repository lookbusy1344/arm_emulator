<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="ARMEmulator.Views.ConsoleView">
    <Border Name="ConsoleSurface" Background="{DynamicResource ConsoleBackgroundBrush}">
        <DockPanel>
            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="8,4">
                <Border Name="WaitingPill"
                        DockPanel.Dock="Right"
                        Classes="pill"
                        Tag="WaitingForInput"
                        IsVisible="{Binding IsWaitingForInput}">
                    <TextBlock Text="Waiting for input" />
                </Border>
                <TextBlock Text="Console"
                           Foreground="{DynamicResource ConsoleTextBrush}"
                           Opacity="0.6"
                           FontSize="{DynamicResource FontSizeCaption}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Input row -->
            <Border Name="InputRow"
                    DockPanel.Dock="Bottom"
                    Classes="inputRow"
                    Classes.waiting="{Binding IsWaitingForInput}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Name="PromptMarker" Classes="prompt" Text="&gt;" Margin="0,0,6,0" />
                    <TextBox Name="InputBox"
                             Grid.Column="1"
                             Classes="terminal"
                             Text="{Binding InputText}"
                             PlaceholderText="Enter input..."
                             VerticalAlignment="Center"
                             ToolTip.Tip="Input for the running program (Enter to send)"
                             AutomationProperties.Name="Program Input"
                             AutomationProperties.HelpText="Enter text input for the running program">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SendInputCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Classes="tool"
                            Content="Send"
                            Command="{Binding SendInputCommand}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Send input to program (Enter)"
                            AutomationProperties.Name="Send Input"
                            AutomationProperties.AcceleratorKey="Enter" />
                </Grid>
            </Border>

            <!-- Output with auto-scroll -->
            <ScrollViewer Name="OutputScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox Name="OutputBox"
                         Classes="terminal"
                         Text="{Binding ConsoleOutput}"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         Padding="8,0"
                         AutomationProperties.Name="Console Output"
                         AutomationProperties.HelpText="Program output from stdout and stderr" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
