<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ARMEmulator.ViewModels"
             x:DataType="vm:MainWindowViewModel"
             x:Class="ARMEmulator.Views.ConsoleView">
    <UserControl.Styles>
        <Style Selector="Border.console">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Border.console.waiting">
            <Setter Property="BorderBrush" Value="{DynamicResource StateWaitingBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Classes="console"
            Classes.waiting="{Binding IsWaitingForInput}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8">

        <DockPanel>
            <!-- Header with status indicator -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="Console Output"
                           FontWeight="SemiBold"
                           DockPanel.Dock="Left" />
                <Border DockPanel.Dock="Right"
                        Background="{DynamicResource StateWaitingBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        IsVisible="{Binding IsWaitingForInput}">
                    <TextBlock Text="⏸️ Waiting for input"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnStateBrush}" />
                </Border>
            </DockPanel>

            <!-- Input area at bottom -->
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="0,8,0,0">
                <TextBlock Text="Input:"
                           VerticalAlignment="Center" />
                <TextBox Name="InputBox"
                         Width="400"
                         Text="{Binding InputText}"
                         PlaceholderText="Enter input..."
                         VerticalAlignment="Center"
                         ToolTip.Tip="Enter input for the running program (press Enter or click Send)"
                         AutomationProperties.Name="Program Input"
                         AutomationProperties.HelpText="Enter text input for the running program">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendInputCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Content="Send"
                        Command="{Binding SendInputCommand}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Send input to program (Enter)"
                        AutomationProperties.Name="Send Input"
                        AutomationProperties.AcceleratorKey="Enter" />
            </StackPanel>

            <!-- Output area with auto-scroll -->
            <ScrollViewer Name="OutputScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox Name="OutputBox"
                         Text="{Binding ConsoleOutput}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="Consolas,Menlo,Monaco,Courier New,monospace"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         AutomationProperties.Name="Console Output"
                         AutomationProperties.HelpText="Program output from stdout and stderr" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
