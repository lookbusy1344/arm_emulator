<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ARMEmulator.ViewModels"
        xmlns:views="using:ARMEmulator.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ARMEmulator.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="800"
        MinHeight="600">

    <DockPanel>
        <!-- Menu Bar. Each item's Tag names its shortcut; the code-behind shows the platform gesture. -->
        <Menu Name="MenuBar" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileCommand}" Tag="Open" />
                <MenuItem Header="_Save" Command="{Binding SaveFileCommand}" Tag="Save" />
                <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" Tag="SaveAs" />
                <Separator />
                <MenuItem Header="_Recent Files" SubmenuOpened="RecentFilesMenu_SubmenuOpened" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemTemplate>
                        <DataTemplate>
                            <MenuItem Header="{Binding FileName}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecentFileCommand}" CommandParameter="{Binding Path}" />
                        </DataTemplate>
                    </MenuItem.ItemTemplate>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Examples..." Command="{Binding OpenExampleCommand}" Tag="Examples" />
                <Separator />
                <MenuItem Header="_Preferences..." Command="{Binding ShowPreferencesCommand}" Tag="Preferences" />
                <MenuItem Header="Restart _Backend" Command="{Binding RestartBackendCommand}" />
                <MenuItem Header="_About..." Command="{Binding ShowAboutCommand}" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Assemble" Command="{Binding AssembleCommand}" Tag="Assemble" />
                <MenuItem Header="_Run" Command="{Binding RunCommand}" Tag="Run" />
                <MenuItem Header="_Pause" Command="{Binding PauseCommand}" Tag="Pause" />
                <MenuItem Header="_Step" Command="{Binding StepCommand}" Tag="Step" />
                <MenuItem Header="Step _Over" Command="{Binding StepOverCommand}" Tag="StepOver" />
                <MenuItem Header="Step Ou_t" Command="{Binding StepOutCommand}" Tag="StepOut" />
                <MenuItem Header="R_eset" Command="{Binding ResetCommand}" Tag="Reset" />
                <MenuItem Header="Show _PC" Command="{Binding ShowPcCommand}" Tag="ShowPc" />
                <MenuItem Header="Toggle _Breakpoint" Command="{Binding ToggleBreakpointAtCaretCommand}" Tag="ToggleBreakpoint" />
            </MenuItem>
        </Menu>

        <!-- Toolbar at the top -->
        <views:ToolbarView DockPanel.Dock="Top" />

        <!-- Error bar: visible while ErrorMessage is set -->
        <Border DockPanel.Dock="Top"
                Name="ErrorBar"
                IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource ErrorBackgroundBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="0,1"
                Padding="8,4">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Name="DismissErrorButton"
                        Classes="tool"
                        Command="{Binding DismissErrorCommand}"
                        VerticalAlignment="Top"
                        ToolTip.Tip="Dismiss"
                        AutomationProperties.Name="Dismiss error">
                    <PathIcon Data="{StaticResource IconDismiss}" />
                </Button>
                <PathIcon DockPanel.Dock="Left"
                          Name="ErrorIcon"
                          Data="{StaticResource IconError}"
                          Foreground="{DynamicResource ErrorTextBrush}"
                          Width="16" Height="16"
                          VerticalAlignment="Top"
                          Margin="0,2,8,0" />
                <SelectableTextBlock Name="ErrorText"
                                     Text="{Binding ErrorMessage}"
                                     Foreground="{DynamicResource ErrorTextBrush}"
                                     TextWrapping="Wrap"
                                     MaxHeight="160"
                                     VerticalAlignment="Center"
                                     AutomationProperties.Name="Error message" />
            </DockPanel>
        </Border>

        <!-- Main content area -->
        <Grid Name="ContentGrid">
            <Grid.RowDefinitions>
                <!-- Editor + Right Panel area -->
                <RowDefinition Height="3*" MinHeight="200" />
                <!-- Vertical splitter -->
                <RowDefinition Height="Auto" />
                <!-- Console area -->
                <RowDefinition Height="*" MinHeight="100" />
            </Grid.RowDefinitions>

            <!-- Top section: Editor + Right Panel with horizontal split -->
            <Grid Name="TopSection" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Editor area -->
                    <ColumnDefinition Width="2*" MinWidth="300" />
                    <!-- Horizontal splitter -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Right panel area -->
                    <ColumnDefinition Width="*" MinWidth="250" />
                </Grid.ColumnDefinitions>

                <!-- Editor View -->
                <views:EditorView Grid.Column="0" />

                <!-- Horizontal Splitter -->
                <GridSplitter Grid.Column="1"
                              Classes="column"
                              ResizeDirection="Columns"
                              HorizontalAlignment="Stretch" />

                <!-- Right Panel with tabs -->
                <views:RightPanelView Grid.Column="2" />
            </Grid>

            <!-- Vertical Splitter -->
            <GridSplitter Grid.Row="1"
                          Classes="row"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch" />

            <!-- Console View -->
            <views:ConsoleView Grid.Row="2" />

            <!-- Connection view: covers the content until the backend is reachable -->
            <Border Name="ConnectionView"
                    Grid.RowSpan="3"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static vm:ConnectionState.Connected}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="480">
                    <TextBlock Name="ConnectionTitle" Classes="dialogTitle" HorizontalAlignment="Center"
                               Text="Starting the backend"
                               IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConnectionState.Connecting}}" />
                    <TextBlock Name="ConnectionFailedTitle" Classes="dialogTitle" HorizontalAlignment="Center"
                               Text="Could not reach the backend"
                               IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConnectionState.Failed}}" />
                    <ProgressBar Name="ConnectionProgress" IsIndeterminate="True" Width="200"
                                 IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConnectionState.Connecting}}" />
                    <TextBlock Name="ConnectionFailureText" Classes="hint" TextAlignment="Center"
                               Text="{Binding ConnectionFailure}"
                               IsVisible="{Binding ConnectionFailure, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button Name="RetryButton" Classes="accent" Content="Retry" HorizontalAlignment="Center"
                            Command="{Binding RestartBackendCommand}"
                            IsVisible="{Binding Connection, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:ConnectionState.Failed}}" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
