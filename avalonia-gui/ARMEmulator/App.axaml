<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ARMEmulator.App"
             Name="ARM Emulator"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ARMEmulator/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://ARMEmulator/Themes/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />

        <!-- AvaloniaEdit theme (required for 11.x versions) -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <!-- Custom theme resources can be added here -->
        <StyleInclude Source="avares://ARMEmulator/Themes/CustomStyles.axaml" />
    </Application.Styles>
</Application>